default_platform(:ios)
opt_out_usage

# Fastlane auto-loads iosApp/fastlane/.env (gitignored). Keep
# ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH there.

APP_ID = "se.kjellstrand.lsystemcamera"

platform :ios do

  # Every archive uses `git rev-list --count HEAD` as the build number so
  # uploads rarely collide. Stored on @build_number to share across lanes
  # within one fastlane run. BUILD_NUMBER=<n> overrides it — needed for
  # select_build when archive_for_app_store had to bump past the count.
  before_all do
    @build_number = ENV["BUILD_NUMBER"] || `git rev-list --count HEAD`.strip
    UI.message("Using build number #{@build_number}")
  end

  desc "Regenerate Xcode project from project.yml (idempotent)."
  lane :gen do
    sh("cd .. && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodegen generate")
  end

  # Build the ASC API key, fetch (or create) an Apple Distribution cert and
  # an App Store provisioning profile for APP_ID, then archive via gym.
  private_lane :archive_for_app_store do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )

    # Creates an Apple Distribution cert + installs it in the login keychain
    # if one doesn't exist. Skips if a valid cert is already present.
    get_certificates(
      api_key: api_key,
    )

    # Creates an App Store distribution profile for APP_ID if missing,
    # downloads it locally, installs it. Defaults (adhoc=false,
    # development=false) already mean App Store; setting both explicitly
    # trips a conflict check, so let them default.
    get_provisioning_profile(
      api_key:        api_key,
      app_identifier: APP_ID,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # ASC rejects a build number <= any previously uploaded one, and the
    # commit count can collide (e.g. after a rebase or an upload from another
    # branch). Bump past the latest uploaded build when that happens.
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID).to_i
    if @build_number.to_i <= latest
      UI.important("Build number #{@build_number} already used; using #{latest + 1}")
      @build_number = (latest + 1).to_s
    end

    build_app(
      xcargs: %(CURRENT_PROJECT_VERSION=#{@build_number} PROVISIONING_PROFILE_SPECIFIER="#{profile_name}"),
      export_options: {
        method:         "app-store",
        signingStyle:   "manual",
        teamID:         ENV.fetch("FASTLANE_TEAM_ID"),
        uploadBitcode:  false,
        uploadSymbols:  true,
        provisioningProfiles: { APP_ID => profile_name },
      },
    )

    api_key
  end

  desc "Build a signed App Store archive and upload to TestFlight."
  lane :beta do
    gen
    api_key = archive_for_app_store
    upload_to_testflight(
      api_key:                            api_key,
      skip_waiting_for_build_processing:  true,
      changelog:                          File.read("metadata/en-GB/release_notes.txt").strip,
    )
  end

  desc "Build a signed App Store archive and submit to the App Store (not for review). " \
       "Screenshots are left to the metadata lane — run it after this one."
  lane :release do
    gen
    api_key = archive_for_app_store
    upload_to_app_store(
      api_key:           api_key,
      # The metadata lane owns the screenshots.
      skip_screenshots:  true,
      skip_metadata:     false,
      submit_for_review: false,
    )
  end

  desc "Push App Store metadata (text + screenshots) without uploading a binary."
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )
    upload_to_app_store(
      api_key:               api_key,
      skip_binary_upload:    true,
      skip_screenshots:      false,
      skip_metadata:         false,
      submit_for_review:     false,
      # Replace the ASC screenshot set instead of appending to it — without
      # this, retaken screenshots hit the 10-per-device cap and are skipped.
      overwrite_screenshots: true,
    )
  end
end
